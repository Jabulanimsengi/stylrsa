# Frontend environment variables
# Copy this file to .env.local for local development.
# Next.js automatically loads .env.local, .env.production, and .env.

# Core URLs
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_API_ORIGIN=http://localhost:5000
NEXT_PUBLIC_BASE_PATH=http://localhost:5000
NEXT_PUBLIC_WS_URL=http://localhost:5000
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXTAUTH_URL=http://localhost:3001
COOKIE_DOMAIN=

# Authentication
NEXTAUTH_SECRET=replace-with-a-random-secret
GOOGLE_ID=your-google-client-id
GOOGLE_SECRET=your-google-client-secret

# Data sources / server-side overrides
DATABASE_URL=postgresql://user:password@host:5432/database
BACKEND_URL=
INTERNAL_BACKEND_URL=

# Maps and location
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-public-token
MAPBOX_ACCESS_TOKEN=your-mapbox-server-token
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Media
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_API_KEY=your-cloudinary-api-key
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-upload-preset

# Notifications / analytics / monitoring
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-web-push-public-key
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
SENTRY_DSN=your-sentry-dsn
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn

# Optional flags
NEXT_PUBLIC_ENABLE_PWA=false
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_CLOUDFLARE=false
ALLOW_BUILD_WITH_ERRORS=false
LOCAL_PREVIEW_HOSTNAME=127.0.0.1
