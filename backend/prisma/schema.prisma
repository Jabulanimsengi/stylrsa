generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                         String            @id @default(uuid())
  email                      String            @unique
  password                   String
  firstName                  String
  lastName                   String
  role                       UserRole          @default(CLIENT)
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  resetPasswordToken         String?
  resetPasswordExpires       DateTime?
  emailVerified              Boolean           @default(false)
  verificationToken          String?           @unique
  verificationExpires        DateTime?
  failedLoginAttempts        Int               @default(0)
  accountLockedUntil         DateTime?
  lastLoginAt                DateTime?
  twoFactorEnabled           Boolean           @default(false)
  twoFactorSecret            String?
  twoFactorBackupCodes       String[]          @default([])
  profileImage               String?
  stripeCustomerId           String?
  addresses                  UserAddress[]
  // Seller plan fields
  sellerPlanCode             PlanCode?
  sellerVisibilityWeight     Int?              @default(1)
  sellerMaxListings          Int?              @default(2)
  sellerFeaturedUntil        DateTime?
  sellerPlanPriceCents       Int?
  sellerPlanPaymentStatus    PlanPaymentStatus @default(PENDING_SELECTION)
  sellerPlanPaymentReference String?
  sellerPlanProofSubmittedAt DateTime?
  sellerPlanVerifiedAt       DateTime?
  // Seller profile fields (for product sellers)
  sellerWhatsapp             String?           // Default WhatsApp number for orders
  sellerWebsite              String?           // Seller's main website
  sellerBankName             String?           // Bank name for payments
  sellerBankAccountHolder    String?           // Account holder name
  sellerBankAccountNumber    String?           // Account number
  sellerBankBranchCode       String?           // Branch code
  sellerBankAccountType      String?           // e.g., "Savings", "Cheque"
  sellerPaymentNote          String?           // Note about payment/delivery
  // Seller business profile fields (required for seller approval)
  sellerBusinessName         String?           // Business/store name
  sellerContactPerson        String?           // Contact person full name
  sellerContactPhone         String?           // Contact phone number
  sellerContactEmail         String?           // Contact email (can differ from login email)
  sellerPhysicalAddress      String?           // Physical business address
  sellerProvincesServed      String[]          @default([]) // SA provinces the seller serves
  sellerApprovalStatus       ApprovalStatus    @default(PENDING) // Seller profile approval status
  sellerProfileSubmittedAt   DateTime?         // When the profile was submitted for review
  sellerApprovedAt           DateTime?         // When the profile was approved by admin
  // Relations
  blogs                      Blog[]
  bookings                   Booking[]
  favorites                  Favorite[]
  notifications              Notification[]
  oauthAccounts              OAuthAccount[]
  products                   Product[]
  productOrders              ProductOrder[]    @relation("BuyerOrders")
  salesOrders                ProductOrder[]    @relation("SellerOrders")
  reviews                    Review[]
  salons                     Salon?
  serviceLikes               ServiceLike[]
  candidate                  Candidate?

  @@index([email])
  @@index([verificationToken])
}

model Salon {
  id                   String                        @id @default(uuid())
  name                 String
  slug                 String?                       @unique
  description          String?
  backgroundImage      String?
  logo                 String?
  province             String
  heroImages           String[]
  city                 String
  town                 String
  address              String?
  latitude             Float?
  longitude            Float?
  contactEmail         String?
  phoneNumber          String?
  whatsapp             String?
  website              String?
  bookingType          BookingType                   @default(ONSITE)
  offersMobile         Boolean                       @default(false)
  mobileFee            Float?
  isAvailableNow       Boolean                       @default(false)
  commissionRate       Float                         @default(0.0)
  materials            SalonMaterial[]
  videoShorts          VideoShort[]
  operatingHours       Json?
  operatingDays        String[]
  bookingMessage       String?
  cancellationPolicy   String?                       // Salon's cancellation policy text
  bankName             String?
  accountHolder        String?
  accountNumber        String?
  branchCode           String?
  approvalStatus       ApprovalStatus                @default(PENDING)
  isVerified           Boolean                       @default(false)
  avgRating            Float                         @default(0)
  viewCount            Int                           @default(0)
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  ownerId              String                        @unique
  planCode             PlanCode?                     @default(PREMIUM)
  visibilityWeight     Int                           @default(5)
  maxListings          Int                           @default(9999)
  featuredUntil        DateTime?
  planPriceCents       Int?
  planPaymentStatus    PlanPaymentStatus             @default(PENDING_SELECTION)
  planPaymentReference String?
  planProofSubmittedAt DateTime?
  planVerifiedAt       DateTime?
  beforeAfterPhotos    BeforeAfterPhoto[]
  bookings             Booking[]
  favorites            Favorite[]
  gallery              GalleryImage[]
  reviews              Review[]
  owner                User                          @relation(fields: [ownerId], references: [id])
  trendzProfile        SalonTrendzProfile?
  views                SalonView[]
  services             Service[]
  availability         ServiceProviderAvailability[]
  serviceVideos        ServiceVideo[]
  teamMembers          TeamMember[]
  jobPostings          JobPosting[]

  @@index([approvalStatus])
  @@index([city])
  @@index([province])
  @@index([approvalStatus, city])           // Composite for filtered city searches
  @@index([approvalStatus, visibilityWeight]) // For sorted approved salons listing
  @@index([offersMobile])                   // For mobile salon filtering
}

model ServiceCategory {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  services  Service[]
}

model ServiceProviderAvailability {
  id          String   @id @default(uuid())
  salonId     String
  date        DateTime
  hour        Int
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  salon       Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@unique([salonId, date, hour])
  @@index([salonId, date])
  @@index([date])
}

model Service {
  id                String             @id @default(uuid())
  title             String
  description       String
  price             Float
  duration          Int
  durationMin       Int?               // Minimum duration for variable services
  durationMax       Int?               // Maximum duration for variable services
  pricingType       PricingType?
  images            String[]
  approvalStatus    ApprovalStatus     @default(PENDING)
  salonId           String
  categoryId        String?
  likeCount         Int                @default(0)
  isPopular         Boolean            @default(false)
  isFeatured        Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  beforeAfterPhotos BeforeAfterPhoto[]
  bookings          Booking[]
  promotions        Promotion[]
  category          ServiceCategory?   @relation(fields: [categoryId], references: [id])
  salon             Salon              @relation(fields: [salonId], references: [id])
  likes             ServiceLike[]
  serviceVideos     ServiceVideo[]
  teamMembers       TeamMemberService[]

  @@index([salonId])
  @@index([approvalStatus])
  @@index([isPopular])
  @@index([isFeatured])
  @@index([salonId, approvalStatus])   // Composite for approved services per salon
  @@index([categoryId, approvalStatus]) // For category filtering with approval
}

model Review {
  id                    String         @id @default(uuid())
  rating                Int
  comment               String
  images                String[]       @default([]) // Review photos uploaded by user
  salonOwnerResponse    String?
  salonOwnerRespondedAt DateTime?
  approvalStatus        ApprovalStatus @default(PENDING)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  userId                String
  salonId               String
  bookingId             String         @unique
  booking               Booking        @relation(fields: [bookingId], references: [id])
  salon                 Salon          @relation(fields: [salonId], references: [id])
  author                User           @relation(fields: [userId], references: [id])

  @@index([salonId])
}

model Booking {
  id             String        @id @default(uuid())
  bookingTime    DateTime
  isMobile       Boolean
  totalCost      Float
  depositPaid    Boolean       @default(false)
  commissionAmount Float?
  platformFee    Float?
  paymentFee     Float?
  materialSelection String?    // e.g., "HAVE_OWN", "BUY_SALON", "BUY_PLATFORM"
  colorSelection    String?
  status         BookingStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  userId         String
  salonId        String
  serviceId      String
  teamMemberId   String?       // Optional: selected professional/stylist
  clientPhone    String?
  referralSource String?
  clientNotes    String?       // Notes about client preferences
  salon          Salon         @relation(fields: [salonId], references: [id])
  service        Service       @relation(fields: [serviceId], references: [id])
  user           User          @relation(fields: [userId], references: [id])
  teamMember     TeamMember?   @relation(fields: [teamMemberId], references: [id])
  review         Review?

  @@index([userId])
  @@index([salonId])
  @@index([serviceId])
  @@index([teamMemberId])
}

model BookingWhatsAppIntent {
  id              String   @id @default(uuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  salonId         String
  serviceId       String
  userId          String?
  teamMemberId    String?
  bookingTime     DateTime
  isMobile        Boolean  @default(false)
  clientFirstName String
  clientLastName  String
  clientPhone     String
  clientNotes     String?
  colorSelection  String?
  materialSelection String?
  totalCost       Float
  depositAmount   Float
  referenceCode   String   @unique
  sequenceNumber  Int
  whatsappClicks  Int      @default(1)
  source          String   @default("STYLRSA")

  @@index([salonId])
  @@index([serviceId])
  @@index([userId])
  @@index([bookingTime])
}

model Product {
  id             String         @id @default(uuid())
  name           String
  slug           String?        @unique // SEO-friendly URL slug
  description    String
  price          Float
  images         String[]
  isOnSale       Boolean        @default(false)
  salePrice      Float?
  approvalStatus ApprovalStatus @default(PENDING)
  stock          Int            @default(0)
  category       String?        // Product category
  transportFee   Float?
  transportConditions Json?
  conditions     Json?
  // Purchase options - per-product overrides
  whatsappNumber String?        // WhatsApp number for this product
  websiteUrl     String?        // Direct website/store link
  takealotUrl    String?        // Takealot product link
  amazonUrl      String?        // Amazon product link
  purchaseNote   String?        // Custom message when user clicks to buy
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  sellerId       String
  seller         User           @relation(fields: [sellerId], references: [id])
  orders         ProductOrder[]
  promotions     Promotion[]

  @@index([slug])
  @@index([approvalStatus])              // For approved products listing
  @@index([sellerId, approvalStatus])    // For seller's approved products
  @@index([category])                    // For category filtering
}

model Promotion {
  id                 String         @id @default(uuid())
  description        String?
  discountPercentage Float
  originalPrice      Float
  promotionalPrice   Float
  startDate          DateTime
  endDate            DateTime
  approvalStatus     ApprovalStatus @default(PENDING)
  approvedBy         String?
  approvedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  serviceId          String?
  productId          String?
  salonId            String?
  product            Product?       @relation(fields: [productId], references: [id], onDelete: Cascade)
  service            Service?       @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([approvalStatus])
  @@index([salonId])
  @@index([serviceId])
  @@index([productId])
  @@index([endDate])
}

model Notification {
  id        String   @id @default(uuid())
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String
  bookingId String?
  link      String?
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model ProductOrder {
  id             String             @id @default(uuid())
  productId      String
  buyerId        String
  sellerId       String
  quantity       Int
  totalPrice     Float
  status         ProductOrderStatus @default(PENDING)
  deliveryMethod String?
  contactPhone   String?
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  buyer          User               @relation("BuyerOrders", fields: [buyerId], references: [id])
  product        Product            @relation(fields: [productId], references: [id])
  seller         User               @relation("SellerOrders", fields: [sellerId], references: [id])

  @@index([buyerId])
  @@index([sellerId])
  @@index([productId])
}

model Favorite {
  userId    String
  salonId   String
  createdAt DateTime @default(now())
  salon     Salon    @relation(fields: [salonId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@id([userId, salonId])
  @@index([salonId])
}

model ServiceLike {
  userId    String
  serviceId String
  createdAt DateTime @default(now())
  service   Service  @relation(fields: [serviceId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@id([userId, serviceId])
  @@index([serviceId])
}

model GalleryImage {
  id        String   @id @default(uuid())
  imageUrl  String
  caption   String?
  salonId   String
  createdAt DateTime @default(now())
  salon     Salon    @relation(fields: [salonId], references: [id])

  @@index([salonId])
}

model BeforeAfterPhoto {
  id              String         @id @default(uuid())
  beforeImageUrl  String
  afterImageUrl   String
  caption         String?
  approvalStatus  ApprovalStatus @default(PENDING)
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  salonId         String
  serviceId       String?
  salon           Salon          @relation(fields: [salonId], references: [id], onDelete: Cascade)
  service         Service?       @relation(fields: [serviceId], references: [id])

  @@index([salonId])
  @@index([serviceId])
  @@index([approvalStatus])
  @@index([createdAt])
}

model ServiceVideo {
  id              String         @id @default(uuid())
  videoUrl        String
  vimeoId         String         @unique
  thumbnailUrl    String?
  duration        Int
  caption         String?
  approvalStatus  ApprovalStatus @default(PENDING)
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?
  views           Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  salonId         String
  serviceId       String?
  salon           Salon          @relation(fields: [salonId], references: [id], onDelete: Cascade)
  service         Service?       @relation(fields: [serviceId], references: [id])

  @@index([salonId])
  @@index([serviceId])
  @@index([approvalStatus])
  @@index([createdAt])
  @@index([views])
}

model OAuthAccount {
  id                String   @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Plan {
  id               String   @id @default(uuid())
  code             PlanCode @unique
  name             String
  priceCents       Int
  visibilityWeight Int
  maxListings      Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model DeletedSalonArchive {
  id         String    @id @default(uuid())
  salonId    String
  ownerId    String
  salon      Json
  services   Json
  reason     String?
  deletedBy  String?
  deletedAt  DateTime  @default(now())
  restoredAt DateTime?

  @@index([deletedAt])
}

model DeletedSellerArchive {
  id         String    @id @default(uuid())
  sellerId   String
  seller     Json
  products   Json
  reason     String?
  deletedBy  String?
  deletedAt  DateTime  @default(now())
  restoredAt DateTime?

  @@index([deletedAt])
}

model AdminActionLog {
  id         String   @id @default(uuid())
  adminId    String
  action     String
  targetType String
  targetId   String
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

model Trend {
  id                       String        @id @default(uuid())
  title                    String
  description              String
  images                   String[]
  category                 TrendCategory
  ageGroups                AgeGroup[]
  styleName                String?
  tags                     String[]      @default([])
  isActive                 Boolean       @default(true)
  priority                 Int           @default(0)
  viewCount                Int           @default(0)
  likeCount                Int           @default(0)
  shareCount               Int           @default(0)
  clickThroughCount        Int           @default(0)
  relatedServiceCategories String[]      @default([])
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  createdBy                String
  likes                    TrendLike[]
  views                    TrendView[]

  @@index([category])
  @@index([isActive])
  @@index([priority])
  @@index([createdAt])
}

model TrendLike {
  id        String   @id @default(uuid())
  userId    String
  trendId   String
  createdAt DateTime @default(now())
  trend     Trend    @relation(fields: [trendId], references: [id], onDelete: Cascade)

  @@unique([userId, trendId])
  @@index([userId])
  @@index([trendId])
}

model TrendView {
  id        String   @id @default(uuid())
  trendId   String
  userId    String?
  ipAddress String?
  viewedAt  DateTime @default(now())
  trend     Trend    @relation(fields: [trendId], references: [id], onDelete: Cascade)

  @@index([trendId])
  @@index([userId])
  @@index([viewedAt])
}

model SalonView {
  id        String   @id @default(uuid())
  salonId   String
  userId    String?
  ipAddress String?
  viewedAt  DateTime @default(now())
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([salonId])
  @@index([userId])
  @@index([viewedAt])
}

model Blog {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  description String
  content     Json
  category    String
  featured    Boolean   @default(false)
  published   Boolean   @default(false)
  readTime    String?
  authorId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  author      User      @relation(fields: [authorId], references: [id])

  @@index([published])
  @@index([featured])
  @@index([category])
  @@index([slug])
  @@index([createdAt])
}

model SalonTrendzProfile {
  id           String          @id @default(uuid())
  salonId      String          @unique
  isEnabled    Boolean         @default(false)
  categories   TrendCategory[] @default([])
  isPremium    Boolean         @default(false)
  premiumUntil DateTime?
  impressions  Int             @default(0)
  clicks       Int             @default(0)
  bookings     Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  salon        Salon           @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([isEnabled])
  @@index([isPremium])
}

model SeoKeyword {
  id           String         @id @default(uuid())
  keyword      String         @unique @db.VarChar(255)
  slug         String         @unique @db.VarChar(255)
  category     String         @db.VarChar(50)
  priority     Int            @default(2)
  searchVolume Int?           @map("search_volume")
  difficulty   Int?
  variations   String[]
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  cachedPages  SeoPageCache[]

  @@index([slug])
  @@index([category])
  @@index([priority])
  @@map("seo_keywords")
}

model SeoLocation {
  id               String         @id @default(uuid())
  name             String         @db.VarChar(255)
  slug             String         @db.VarChar(255)
  type             String         @db.VarChar(50)
  province         String         @db.VarChar(100)
  provinceSlug     String         @map("province_slug") @db.VarChar(100)
  parentLocationId String?        @map("parent_location_id")
  latitude         Decimal?       @db.Decimal(10, 8)
  longitude        Decimal?       @db.Decimal(11, 8)
  population       Int?
  serviceCount     Int            @default(0) @map("service_count")
  salonCount       Int            @default(0) @map("salon_count")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  parentLocation   SeoLocation?   @relation("LocationHierarchy", fields: [parentLocationId], references: [id])
  childLocations   SeoLocation[]  @relation("LocationHierarchy")
  cachedPages      SeoPageCache[]

  @@index([slug])
  @@index([type])
  @@index([provinceSlug])
  @@index([parentLocationId])
  @@map("seo_locations")
}

model SeoPageCache {
  id              String      @id @default(uuid())
  keywordId       String      @map("keyword_id")
  locationId      String      @map("location_id")
  url             String      @unique @db.VarChar(500)
  h1              String
  h2Headings      String[]    @map("h2_headings")
  h3Headings      String[]    @map("h3_headings")
  introText       String      @map("intro_text")
  metaTitle       String      @map("meta_title") @db.VarChar(60)
  metaDescription String      @map("meta_description") @db.VarChar(160)
  schemaMarkup    Json?       @map("schema_markup")
  relatedServices Json?       @map("related_services")
  nearbyLocations Json?       @map("nearby_locations")
  serviceCount    Int         @default(0) @map("service_count")
  salonCount      Int         @default(0) @map("salon_count")
  avgPrice        Decimal?    @map("avg_price") @db.Decimal(10, 2)
  lastGenerated   DateTime    @default(now()) @map("last_generated")
  createdAt       DateTime    @default(now()) @map("created_at")
  keyword         SeoKeyword  @relation(fields: [keywordId], references: [id])
  location        SeoLocation @relation(fields: [locationId], references: [id])

  @@index([url])
  @@index([keywordId])
  @@index([locationId])
  @@index([lastGenerated])
  @@map("seo_page_cache")
}

enum UserRole {
  CLIENT
  SALON_OWNER
  ADMIN
  PRODUCT_SELLER
  CANDIDATE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookingType {
  ONSITE
  MOBILE
  BOTH
}

enum BookingStatus {
  PENDING
  CONFIRMED
  DECLINED
  COMPLETED
  CANCELLED
}

enum PricingType {
  PER_PERSON
  PER_COUPLE
}

enum ProductOrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PlanCode {
  FREE
  STARTER    // Legacy - grandfathered
  ESSENTIAL  // Legacy - grandfathered
  GROWTH     // Legacy - grandfathered
  PRO        // Legacy - grandfathered
  ELITE      // Legacy - grandfathered
  PREMIUM    // Single paid plan R399/month
}

enum PlanPaymentStatus {
  PENDING_SELECTION
  AWAITING_PROOF
  PROOF_SUBMITTED
  VERIFIED
}

enum TrendCategory {
  HAIRSTYLE
  NAILS
  SPA
  MAKEUP
  SKINCARE
  MASSAGE
  BARBERING
  BRAIDS
  LOCS
  EXTENSIONS
}

enum AgeGroup {
  KIDS
  TEENS
  YOUNG_ADULTS
  ADULTS
  MATURE_ADULTS
  ALL_AGES
}

model Candidate {
  id                  String              @id @default(uuid())
  userId              String              @unique
  user                User                @relation(fields: [userId], references: [id])
  profession          CandidateProfession
  province            String
  city                String
  willingToTravel     Boolean             @default(false)
  preferredLocations  String[]
  yearsExperience     Int
  qualifications      String[]
  previousWorkplaces  String[]
  portfolio           String[]
  availableDays       String[]
  availableTimes      String?
  urgentBookings      Boolean             @default(false)
  weekendsHolidays    Boolean             @default(false)
  specializations     String[]
  techniques          String[]
  questionnaireAnswers Json?
  
  // Privacy
  showFirstName       Boolean             @default(true)
  showLastName        Boolean             @default(false)
  showEmail           Boolean             @default(false)
  showPhone           Boolean             @default(false)

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

enum CandidateProfession {
  HAIRDRESSER
  NAIL_TECH
  MASSAGE_THERAPIST
  MAKEUP_ARTIST
  BARBER
  ESTHETICIAN
  LASH_TECH
  BROW_ARTIST
  SPA_THERAPIST
  SALON_MANAGER
  RECEPTIONIST
  BEAUTY_THERAPIST
}

model TeamMember {
  id          String              @id @default(uuid())
  salonId     String
  name        String
  role        String
  bio         String?
  image       String?
  specialties String[]
  experience  Int?
  isActive    Boolean             @default(true)
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  salon       Salon               @relation(fields: [salonId], references: [id], onDelete: Cascade)
  bookings    Booking[]
  services    TeamMemberService[]

  @@index([salonId])
  @@index([isActive])
}

// Junction table for team members and their services
model TeamMemberService {
  id           String     @id @default(uuid())
  teamMemberId String
  serviceId    String
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  service      Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([teamMemberId, serviceId])
  @@index([teamMemberId])
  @@index([serviceId])
}

model JobPosting {
  id              String        @id @default(uuid())
  salonId         String
  title           String
  description     String
  jobType         JobType
  salaryMin       Float?
  salaryMax       Float?
  salaryPeriod    SalaryPeriod?
  requirements    String[]
  benefits        String[]
  experienceLevel String?
  isRemote        Boolean       @default(false)
  isActive        Boolean       @default(true)
  expiresAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  salon           Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  applications    JobApplication[]

  @@index([salonId])
  @@index([isActive])
  @@index([jobType])
  @@index([createdAt])
}

model JobApplication {
  id           String               @id @default(uuid())
  jobId        String
  candidateId  String?
  name         String
  email        String
  phone        String?
  coverLetter  String?
  resumeUrl    String?
  status       JobApplicationStatus @default(PENDING)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  job          JobPosting           @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([status])
  @@index([createdAt])
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  FREELANCE
  INTERNSHIP
}

enum SalaryPeriod {
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
  ANNUALLY
}

enum JobApplicationStatus {
  PENDING
  REVIEWED
  SHORTLISTED
  INTERVIEWED
  OFFERED
  HIRED
  REJECTED
}


model Top10Request {
  id            String   @id @default(uuid())
  userId        String?
  fullName      String
  phone         String
  whatsapp      String?
  email         String?
  category      String
  serviceNeeded String
  styleOrLook   String?
  budget        String
  serviceType   String
  location      String
  latitude      Float?
  longitude     Float?
  preferredDate DateTime
  preferredTime String?
  images        String[] @default([])
  status        String   @default("PENDING")
  adminNotes    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@index([userId])
}

model UserAddress {
  id          String   @id @default(uuid())
  userId      String
  label       String   @default("HOME") // HOME, WORK, OTHER
  address     String
  latitude    Float?
  longitude   Float?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SalonMaterial {
  id          String   @id @default(uuid())
  salonId     String
  name        String
  description String?
  imageUrl    String?
  isUsed      Boolean  @default(true)  // Material the salon USES
  isSold      Boolean  @default(false) // Material the salon SELLS/HAS
  price       Float?   // Price if sold
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  salon       Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([salonId])
}

model VideoShort {
  id           String   @id @default(uuid())
  salonId      String
  videoUrl     String
  thumbnailUrl String?
  caption      String?
  views        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  salon        Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([salonId])
  @@index([createdAt])
}

